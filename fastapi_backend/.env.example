# ONLYOFFICE / shared files (copy to .env and fill real values; do not commit secrets)
ONLYOFFICE_URL=http://<SERVER_IP>:8082
ONLYOFFICE_JWT_SECRET=<same as Docker JWT_SECRET>
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_PUBLIC_API_BASE=http://<SERVER_IP>:8000
SHARED_FILES_DIR=data/shared_files
SHARED_FILES_MAX_SIZE_MB=50
# optional; empty falls back to ONLYOFFICE_JWT_SECRET
SHARED_FILES_SIGNING_SECRET=
SHARED_FILES_DOWNLOAD_TOKEN_TTL_SECONDS=900
